---
// Default entry is language-neutral; users choose their preferred interface language.
import {pagePath} from '../lib/urls';
---
<html lang="en"><head><meta charset="utf-8"/><meta name="robots" content="noindex"/><title>LitMundi</title><meta http-equiv="refresh" content={`0;url=${pagePath("en")}`}/></head><body><a href={pagePath("en")}>English</a> · <a href={pagePath("vi")}>Tiếng Việt</a> · <a href={pagePath("fr")}>Français</a> · <a href={pagePath("es")}>Español</a><script>
  import {pagePath} from '../lib/urls';
  const preferred = (navigator.languages || [navigator.language]).map(l => l.split('-')[0]);
  const selected = preferred.find(l => ['en','vi','fr','es'].includes(l)) || 'en';
  location.replace(pagePath(selected));
</script></body></html>