---
import Base from '../../layouts/Base.astro';
import rubric from '../../../corpus/reviews/rubric-literary-v1.json';
import {strings,supported,type Locale} from '../../lib/i18n';
import {pagePath} from '../../lib/urls';
export function getStaticPaths(){return supported.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Locale,t=strings[lang];
const content={
  en:{title:'A translation earns its place.',intro:'Every published translation must be complete, lawful and faithful to its exact source. Two independent, qualified human reviewers must approve the final text.',dimensions:'The literary standard',gates:'Requirements for publication',ai:'An AI score cannot authorize publication.',notes:'Scores guide editorial judgment. Maintainers must verify reviewer qualifications, independence, evidence and contributor permissions. A source-checked original is not a reviewed translation.',handbook:'Reviewer handbook',criteria:[['Fidelity and completeness','Preserve meaning and deliberate ambiguity. No invented, omitted or reversed ideas.'],['Voice, rhythm and register','Keep the author’s tone, repetition, cadence and stylistic choices.'],['Naturalness','Write idiomatic literary prose that withstands reading aloud.'],['Imagery and terminology','Preserve metaphors, cultural references and recurring terms.'],['Editorial mechanics','Use accurate grammar, spelling, punctuation and typography.']],requirements:['Each of two independent human reviewers: weighted score ≥9.0/10.','Semantic fidelity ≥9.0; every other dimension ≥8.0, for each reviewer.','Every canonical passage reviewed; no unresolved major or critical errors.','Review evidence bound to the exact source and translation SHA-256 hashes.','Verified source provenance and rights; named contributors and documented permission for an open license.']},
  vi:{title:'Bản dịch phải xứng đáng với chỗ đứng của mình.',intro:'Mỗi bản dịch được xuất bản phải trọn vẹn, hợp pháp và trung thành với đúng văn bản nguồn. Hai người kiểm định độc lập, đủ chuyên môn phải duyệt văn bản cuối cùng.',dimensions:'Tiêu chuẩn văn học',gates:'Điều kiện xuất bản',ai:'Điểm do AI chấm không cho phép xuất bản.',notes:'Điểm số hỗ trợ phán đoán biên tập. Người duy trì phải xác minh chuyên môn, tính độc lập, bằng chứng kiểm định và quyền của người đóng góp. Nguyên tác đã đối chiếu nguồn không đồng nghĩa với bản dịch đã kiểm định.',handbook:'Sổ tay người kiểm định',criteria:[['Trung thành và đầy đủ','Giữ nghĩa và sự mơ hồ có chủ ý. Không thêm, bỏ hoặc đảo ngược ý.'],['Giọng văn, nhịp điệu và sắc thái','Giữ giọng tác giả, sự lặp lại, nhịp câu và lựa chọn phong cách.'],['Tự nhiên trong tiếng đích','Văn chương đúng ngữ cảm, đứng vững khi đọc thành tiếng.'],['Hình ảnh và thuật ngữ','Giữ ẩn dụ, chi tiết văn hóa và các từ ngữ lặp lại.'],['Chính tả và biên tập','Chính xác về ngữ pháp, chính tả, dấu câu và trình bày.']],requirements:['Mỗi người trong hai người kiểm định độc lập chấm tổng điểm có trọng số ≥9,0/10.','Độ trung thành ≥9,0; từng tiêu chí còn lại ≥8,0, theo đánh giá của mỗi người.','Kiểm định mọi đoạn chuẩn; không còn lỗi nghiêm trọng hoặc lỗi lớn chưa giải quyết.','Bằng chứng kiểm định gắn với mã SHA-256 chính xác của nguyên tác và bản dịch.','Xác minh nguồn và quyền sử dụng; ghi tên người đóng góp và quyền cấp giấy phép mở bằng văn bản.']},
  fr:{title:'Une traduction doit mériter sa place.',intro:'Toute traduction publiée doit être complète, licite et fidèle à sa source précise. Deux réviseurs humains indépendants et qualifiés doivent approuver le texte final.',dimensions:'L’exigence littéraire',gates:'Conditions de publication',ai:'Une note d’IA ne peut pas autoriser la publication.',notes:'Les notes éclairent le jugement éditorial. Les responsables vérifient les compétences, l’indépendance, les preuves et les permissions. Un original comparé à sa source n’est pas une traduction révisée.',handbook:'Manuel des réviseurs',criteria:[['Fidélité et intégralité','Préserver le sens et l’ambiguïté voulue, sans ajout, omission ni inversion.'],['Voix, rythme et registre','Conserver le ton, les répétitions, la cadence et les choix stylistiques.'],['Naturel de la langue','Une prose littéraire idiomatique qui résiste à la lecture à voix haute.'],['Images et terminologie','Respecter les métaphores, les références culturelles et les termes récurrents.'],['Correction éditoriale','Grammaire, orthographe, ponctuation et typographie exactes.']],requirements:['Chacun des deux réviseurs humains indépendants : note pondérée ≥9,0/10.','Fidélité ≥9,0 ; chaque autre critère ≥8,0, pour chacun des réviseurs.','Tous les passages vérifiés, sans erreur majeure ou critique non résolue.','Preuves de révision liées aux empreintes SHA-256 exactes de la source et de la traduction.','Sources et droits vérifiés ; contributeurs nommés et permission écrite d’utiliser une licence ouverte.']},
  es:{title:'Una traducción debe ganarse su lugar.',intro:'Toda traducción publicada debe estar completa, ser lícita y fiel a su fuente exacta. Dos revisores humanos independientes y cualificados deben aprobar el texto final.',dimensions:'El criterio literario',gates:'Requisitos de publicación',ai:'Una puntuación de IA no autoriza la publicación.',notes:'Las puntuaciones orientan el juicio editorial. Los responsables verifican cualificaciones, independencia, pruebas y permisos. Un original cotejado con su fuente no es una traducción revisada.',handbook:'Manual para revisores',criteria:[['Fidelidad e integridad','Conservar el sentido y la ambigüedad deliberada, sin inventar, omitir o invertir ideas.'],['Voz, ritmo y registro','Mantener el tono, las repeticiones, la cadencia y las decisiones de estilo.'],['Naturalidad','Prosa literaria idiomática que resista la lectura en voz alta.'],['Imágenes y terminología','Respetar metáforas, referencias culturales y términos recurrentes.'],['Corrección editorial','Gramática, ortografía, puntuación y tipografía precisas.']],requirements:['Cada uno de los dos revisores humanos independientes: puntuación ponderada ≥9,0/10.','Fidelidad ≥9,0; cada otra dimensión ≥8,0, para cada revisor.','Todos los pasajes revisados, sin errores mayores o críticos pendientes.','Pruebas de revisión vinculadas a los hashes SHA-256 exactos del original y la traducción.','Procedencia y derechos verificados; colaboradores identificados y permiso escrito para una licencia abierta.']},
}[lang];
---
<Base lang={lang} title={t.quality}>
<div class="container">
  <section class="hero"><p class="eyebrow">LitMundi · v1</p><h1>{content.title}</h1><p>{content.intro}</p></section>
  <section class="section"><h2>{content.dimensions}</h2><div class="grid quality-grid">{rubric.criteria.map((criterion,index)=><article class="card"><p class="eyebrow">{criterion.weight}%</p><h3>{content.criteria[index][0]}</h3><p>{content.criteria[index][1]}</p></article>)}</div></section>
  <section class="section policy-body"><h2>{content.gates}</h2><ol>{content.requirements.map(requirement=><li>{requirement}</li>)}</ol><p><strong>{content.ai}</strong></p><p>{content.notes}</p><p><a class="button" href="https://github.com/streamentry/LitMundi/blob/main/docs/QUALITY.md">{content.handbook} <span aria-hidden="true">↗</span></a></p><p><a href={pagePath(lang)}>← {t.back}</a></p></section>
</div>
</Base>
