---
import Base from '../../layouts/Base.astro';
import rubric from '../../../corpus/reviews/rubric-literary-v2.json';
import {strings,supported,type Locale} from '../../lib/i18n';
import {pagePath} from '../../lib/urls';
import {labels} from '../../lib/discovery';
export function getStaticPaths(){return supported.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Locale,t=strings[lang];
const threshold=rubric.release_gate.min_score_each_reviewer.toLocaleString(lang,{minimumFractionDigits:1,maximumFractionDigits:2});
const content={
  en:{title:'AI review. Open reading. Ongoing correction.',intro:`Under the current policy, a complete translation may be published after an AI literary review scores at least ${threshold}/10 and the rights and integrity checks pass. Human readers can then review it, report errors and suggest improvements.`,dimensions:'The literary standard',gates:'Requirements for publication',ai:'AI-reviewed editions are labeled as AI-reviewed. They do not imply independent human approval.',notes:'An AI score is an editorial judgment, not an objective guarantee of literary quality. The review record, exact text version, sources and permissions remain visible. Corrections can lead to a new review, revision or withdrawal.',handbook:'Policy and review records',historyTitle:'Earlier policy and review history',history:'Version 1 required two independent qualified human reviews scoring at least 9.0/10. That policy and its records are retained as history; it is not the prerequisite for AI-reviewed publication under version 2.',criteria:[['Fidelity and completeness','Preserve meaning and deliberate ambiguity. No invented, omitted or reversed ideas.'],['Voice, rhythm and register','Keep the author’s tone, repetition, cadence and stylistic choices.'],['Naturalness','Write idiomatic literary prose that withstands reading aloud.'],['Imagery and terminology','Preserve metaphors, cultural references and recurring terms.'],['Editorial mechanics','Use accurate grammar, spelling, punctuation and typography.']],requirements:[`At least one current AI literary review with a weighted score ≥${threshold}/10, covering every canonical passage.`, 'Complete original and translation texts with explicit passage alignment.','No unresolved major or critical translation errors.','Review evidence bound to the exact source and translation SHA-256 hashes; an old score cannot approve changed text.','Documented source provenance, lawful publication rights and applicable open-content permissions.','Clear AI-review labeling and a public correction channel. Human review and reader feedback can follow publication.']},
  vi:{title:'AI đánh giá. Bạn đọc góp ý. Bản dịch được sửa tiếp.',intro:`Theo chính sách hiện hành, bản dịch hoàn chỉnh có thể được xuất bản khi đánh giá văn học bằng AI đạt từ ${threshold}/10 và đáp ứng yêu cầu về quyền sử dụng, tính toàn vẹn. Bạn đọc sau đó có thể đánh giá, báo lỗi và đề nghị cải thiện.`,dimensions:'Tiêu chuẩn văn học',gates:'Điều kiện xuất bản',ai:'Ấn bản do AI đánh giá được ghi rõ như vậy. Nhãn này không hàm ý đã được con người kiểm định độc lập.',notes:'Điểm AI là một nhận định biên tập, không phải bảo đảm khách quan về chất lượng văn học. Hồ sơ đánh giá, phiên bản văn bản, nguồn và quyền sử dụng vẫn được công khai. Góp ý có thể dẫn đến đánh giá lại, sửa bản dịch hoặc thu hồi ấn bản.',handbook:'Chính sách và hồ sơ đánh giá',historyTitle:'Chính sách trước đây và lịch sử đánh giá',history:'Phiên bản 1 yêu cầu hai người đủ chuyên môn đánh giá độc lập, mỗi người chấm từ 9,0/10. Chính sách và hồ sơ đó được giữ lại như lịch sử; đây không còn là điều kiện tiên quyết để xuất bản theo đánh giá AI ở phiên bản 2.',criteria:[['Trung thành và đầy đủ','Giữ nghĩa và sự mơ hồ có chủ ý. Không thêm, bỏ hoặc đảo ngược ý.'],['Giọng văn, nhịp điệu và sắc thái','Giữ giọng tác giả, sự lặp lại, nhịp câu và lựa chọn phong cách.'],['Tự nhiên trong tiếng đích','Văn chương đúng ngữ cảm, đứng vững khi đọc thành tiếng.'],['Hình ảnh và thuật ngữ','Giữ ẩn dụ, chi tiết văn hóa và các từ ngữ lặp lại.'],['Chính tả và biên tập','Chính xác về ngữ pháp, chính tả, dấu câu và trình bày.']],requirements:[`Ít nhất một đánh giá văn học bằng AI còn hiệu lực, bao quát mọi đoạn chuẩn, với tổng điểm có trọng số ≥${threshold}/10.`,'Nguyên tác và bản dịch trọn vẹn, có căn chỉnh đoạn văn rõ ràng.','Không còn lỗi lớn hoặc nghiêm trọng chưa giải quyết.','Bằng chứng đánh giá gắn với mã SHA-256 chính xác của nguyên tác và bản dịch; điểm cũ không duyệt được văn bản đã đổi.','Ghi rõ nguồn, căn cứ xuất bản hợp pháp và quyền sử dụng nội dung mở tương ứng.','Ghi rõ vai trò đánh giá của AI và có kênh góp ý công khai. Con người có thể đánh giá và phản hồi sau khi xuất bản.']},
  fr:{title:'Évaluation par IA. Lecture ouverte. Corrections continues.',intro:`Selon la politique actuelle, une traduction complète peut être publiée après une évaluation littéraire par IA d’au moins ${threshold}/10 et la vérification des droits et de l’intégrité. Les lecteurs peuvent ensuite l’examiner, signaler les erreurs et proposer des améliorations.`,dimensions:'L’exigence littéraire',gates:'Conditions de publication',ai:'Les éditions évaluées par IA sont indiquées comme telles. Cette mention ne signifie pas une approbation humaine indépendante.',notes:'Une note d’IA est un jugement éditorial, pas une garantie objective de qualité littéraire. L’évaluation, la version exacte, les sources et les permissions restent visibles. Les corrections peuvent entraîner une nouvelle évaluation, une révision ou un retrait.',handbook:'Politique et dossiers d’évaluation',historyTitle:'Politique antérieure et historique',history:'La version 1 exigeait deux évaluations humaines indépendantes et qualifiées, chacune d’au moins 9,0/10. Cette politique et ses dossiers sont conservés comme historique ; ils ne sont pas un préalable à la publication par IA selon la version 2.',criteria:[['Fidélité et intégralité','Préserver le sens et l’ambiguïté voulue, sans ajout, omission ni inversion.'],['Voix, rythme et registre','Conserver le ton, les répétitions, la cadence et les choix stylistiques.'],['Naturel de la langue','Une prose littéraire idiomatique qui résiste à la lecture à voix haute.'],['Images et terminologie','Respecter les métaphores, les références culturelles et les termes récurrents.'],['Correction éditoriale','Grammaire, orthographe, ponctuation et typographie exactes.']],requirements:[`Au moins une évaluation littéraire actuelle par IA, couvrant tous les passages, avec une note pondérée ≥${threshold}/10.`,'Original et traduction complets, avec alignement explicite des passages.','Aucune erreur majeure ou critique non résolue.','Preuves liées aux empreintes SHA-256 exactes de la source et de la traduction ; une ancienne note ne valide pas un texte modifié.','Sources documentées, droits de publication licites et permissions applicables à un contenu ouvert.','Mention claire de l’évaluation par IA et canal public de correction. L’examen humain et les retours des lecteurs peuvent suivre la publication.']},
  es:{title:'Evaluación por IA. Lectura abierta. Corrección continua.',intro:`La política actual permite publicar una traducción completa tras una evaluación literaria por IA de al menos ${threshold}/10 y la verificación de derechos e integridad. Los lectores pueden después revisarla, señalar errores y proponer mejoras.`,dimensions:'El criterio literario',gates:'Requisitos de publicación',ai:'Las ediciones evaluadas por IA se identifican como tales. Esta etiqueta no implica una aprobación humana independiente.',notes:'Una puntuación de IA es un juicio editorial, no una garantía objetiva de calidad literaria. La evaluación, la versión exacta, las fuentes y los permisos siguen siendo visibles. Las correcciones pueden dar lugar a una nueva evaluación, revisión o retirada.',handbook:'Política y registros de evaluación',historyTitle:'Política anterior e historial',history:'La versión 1 exigía dos evaluaciones humanas independientes y cualificadas de al menos 9,0/10 cada una. La política y sus registros se conservan como historial; no son un requisito previo para publicar según la evaluación por IA de la versión 2.',criteria:[['Fidelidad e integridad','Conservar el sentido y la ambigüedad deliberada, sin inventar, omitir o invertir ideas.'],['Voz, ritmo y registro','Mantener el tono, las repeticiones, la cadencia y las decisiones de estilo.'],['Naturalidad','Prosa literaria idiomática que resista la lectura en voz alta.'],['Imágenes y terminología','Respetar metáforas, referencias culturales y términos recurrentes.'],['Corrección editorial','Gramática, ortografía, puntuación y tipografía precisas.']],requirements:[`Al menos una evaluación literaria actual por IA que cubra todos los pasajes, con una puntuación ponderada ≥${threshold}/10.`,'Original y traducción completos, con alineación explícita de los pasajes.','Ningún error mayor o crítico pendiente.','Pruebas vinculadas a los hashes SHA-256 exactos del original y la traducción; una nota antigua no valida un texto modificado.','Procedencia documentada, derechos de publicación lícitos y permisos aplicables de contenido abierto.','Identificación clara de la evaluación por IA y un canal público de corrección. La revisión humana y los comentarios de lectores pueden seguir a la publicación.']},
}[lang];
---
<Base lang={lang} title={t.quality} description={content.intro} breadcrumbs={[{name:labels(lang).collection,href:pagePath(lang)},{name:t.quality,href:pagePath(lang,'quality')}] }>
<div class="container" data-publication-policy={rubric.id}>
  <section class="hero"><p class="eyebrow">LitMundi · v2 · ≥{threshold}/10</p><h1>{content.title}</h1><p>{content.intro}</p></section>
  <section class="section"><h2>{content.dimensions}</h2><div class="grid quality-grid">{rubric.criteria.map((criterion,index)=><article class="card"><p class="eyebrow">{criterion.weight}%</p><h3>{content.criteria[index][0]}</h3><p>{content.criteria[index][1]}</p></article>)}</div></section>
  <section class="section policy-body"><h2>{content.gates}</h2><ol>{content.requirements.map(requirement=><li>{requirement}</li>)}</ol><p><strong>{content.ai}</strong></p><p>{content.notes}</p><p><a class="button" href="https://github.com/streamentry/LitMundi/blob/main/docs/QUALITY.md">{content.handbook} <span aria-hidden="true">↗</span></a></p><details data-policy-history="litmundi-literary-v1"><summary>{content.historyTitle}</summary><p>{content.history}</p></details><p><a href={pagePath(lang)}>← {t.back}</a></p></section>
</div>
</Base>
