---
import Base from '../../layouts/Base.astro';
import OriginalTitle from '../../components/OriginalTitle.astro';
import {strings,supported,type Locale} from '../../lib/i18n';
import {publicWorks,publishedEditions,languageNames,bestEdition,reviewCategory,editionTitle} from '../../lib/corpus';
import {pagePath,assetPath,basePath} from '../../lib/urls';
import {labels,workSummary,authorSlug} from '../../lib/discovery';
import searchLabels from '../../lib/search-ui.json';
export function getStaticPaths(){return supported.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Locale;const t=strings[lang],d=labels(lang);
const works=publicWorks();
const authors=[...new Set(works.map(w=>w.author))].sort();
const languages=[...new Set(works.flatMap(w=>publishedEditions(w.id).map(e=>e.language)))].sort();
const homeUrl=new URL(pagePath(lang),Astro.site).href;
const structuredData={
  '@context':'https://schema.org','@type':'CollectionPage','@id':homeUrl,
  url:homeUrl,name:d.homeTitle,description:d.homeDescription,inLanguage:lang,
  mainEntity:{'@type':'ItemList','@id':homeUrl+'#collection',numberOfItems:works.length,itemListElement:works.map((work,index)=>({
    '@type':'ListItem',position:index+1,item:{'@type':'CreativeWork',identifier:work.id,name:editionTitle(work,bestEdition(work,lang)),
      url:new URL(pagePath(lang,'works',work.id),Astro.site).href,
      author:{'@type':'Person','@id':new URL(pagePath('en','authors'),Astro.site).href+'#'+authorSlug(work.author),name:work.author}},
  }))},
};
---
<Base lang={lang} title={d.homeTitle} description={d.homeDescription} structuredData={structuredData}>
<div class="container">
  <section class="hero">
    <p class="eyebrow">{t.tag}</p><h1>{t.title}</h1><p>{d.homeDescription}</p>
    <a class="button" href="#collection">{t.explore} <span aria-hidden="true">→</span></a>
  </section>
  <section id="collection" class="section collection-section" aria-labelledby="collection-title">
    <div class="section-head"><h2 id="collection-title">{t.works}</h2><p>{works.length} · {t.collectionCount}</p></div>
    <form id="collection-search" class="search-form" role="search" hidden data-index={assetPath('search-index.json')} data-base={basePath} data-locale={lang} data-none={t.noResults} data-unavailable={t.searchUnavailable} data-loading={t.searchLoading} data-results={t.results} data-search-labels={JSON.stringify(searchLabels[lang])} data-review-labels={JSON.stringify({source:t.sourcePublished,ai:t.aiReviewed,human:t.humanReviewed,translation:t.translationPublished})}>
      <label class="query-label" for="query">{t.search}<input id="query" name="query" type="search" autocomplete="off" placeholder={t.searchHint} /></label>
      <label for="text-language">{t.language}<select name="language" id="text-language"><option value="">{t.allLanguages}</option>{languages.map(code=><option value={code}>{languageNames[code]??code}</option>)}</select></label>
      <label for="author">{t.author}<select name="author" id="author"><option value="">{t.allAuthors}</option>{authors.map(author=><option value={author}>{author}</option>)}</select></label>
      <button type="submit">{t.searchButton}</button>
    </form>
    <noscript><p class="notice">{t.noScriptSearch}</p></noscript>
    <p class="search-status muted" id="search-status" role="status" aria-live="polite"></p>
    <section id="edition-results" class="search-results" aria-labelledby="edition-results-title" hidden><h3 id="edition-results-title">{searchLabels[lang].editions}</h3><ol></ol></section>
    <div class="grid" id="collection-cards">{works.map(work=>{
      const editions=publishedEditions(work.id);const first=bestEdition(work,lang)!;const category=reviewCategory(first),title=editionTitle(work,first);
      const summary=workSummary(work,lang);
      const badge=category==='ai'?t.aiReviewed:category==='human'?t.humanReviewed:category==='source'?t.sourcePublished:t.translationPublished;
      return <article class="card" data-work-id={work.id} data-author={work.author} data-languages={editions.map(e=>e.language).join(' ')}>
        <span class="pill" data-review-category={category}>{badge}</span>
        <h3 lang={first.title?first.language:work.original_language} data-edition-title={first.id}><a href={pagePath(lang,'works',work.id)}>{title}</a></h3>
        {first.kind==='translation'&&title!==work.title&&<OriginalTitle title={work.title} language={work.original_language} locale={lang}/>}
        <p class="muted"><a href={pagePath(lang,'authors')+'#'+authorSlug(work.author)}>{work.author}</a> · {work.first_published_year}<br/>{editions.map(e=>languageNames[e.language]??e.language).filter((v,i,a)=>a.indexOf(v)===i).join(' · ')}</p>
        <p lang={summary.language} data-work-summary={work.id}>{summary.text}</p>
        <a class="card-link" href={pagePath(lang,'read',work.id,first.id)}>{t.read} <span aria-hidden="true">→</span></a>
      </article>;
    })}</div>
    <section id="passage-results" class="search-results" aria-labelledby="results-title" hidden><h3 id="results-title">{t.results}</h3><ol></ol></section>
  </section>
  <section class="section policy-body"><p class="eyebrow">{t.approach}</p><h2>{t.why}</h2><p>{t.whytext}</p><p class="muted">{t.translationPolicy}</p></section>
</div>
<script>
  import {normalizeQuery} from '../../../scripts/lib/reader-data.mjs';
  import {createSearchController,type SearchEdition} from '../../../scripts/lib/search.mjs';
  const form=document.querySelector<HTMLFormElement>('#collection-search');
  if(form){
    form.hidden=false;
    const query=form.elements.namedItem('query') as HTMLInputElement;
    const language=form.elements.namedItem('language') as HTMLSelectElement;
    const author=form.elements.namedItem('author') as HTMLSelectElement;
    const cards=[...document.querySelectorAll<HTMLElement>('[data-work-id]')];
    const status=document.querySelector<HTMLElement>('#search-status')!;
    const results=document.querySelector<HTMLElement>('#passage-results')!;
    const list=results.querySelector('ol')!;
    const editionResults=document.querySelector<HTMLElement>('#edition-results')!;
    const editionList=editionResults.querySelector('ol')!;
    const reviewLabels:Record<string,string>=JSON.parse(form.dataset.reviewLabels!);
    const labels:{editions:string;works:string}=JSON.parse(form.dataset.searchLabels!);
    const controller=createSearchController(async()=>{
      const response=await fetch(form.dataset.index!);
      if(!response.ok)throw new Error('Search unavailable');
      return response.json();
    });
    const filter=(workIds?:Set<string>)=>cards.forEach(card=>{
      card.hidden=Boolean((author.value&&card.dataset.author!==author.value)||(language.value&&!card.dataset.languages?.split(' ').includes(language.value))||(workIds&&!workIds.has(card.dataset.workId!)));
    });
    const clearResults=()=>{results.hidden=true;editionResults.hidden=true;list.replaceChildren();editionList.replaceChildren();};
    const editionLink=(edition:SearchEdition,id?:string)=>{
      const link=document.createElement('a'),title=document.createElement('span');
      link.href=form.dataset.base!+form.dataset.locale!+'/read/'+edition.workId+'/'+edition.editionId+'/'+(id?'#'+encodeURIComponent(id):'');
      link.dataset.searchResult=id?'passage':'edition';link.dataset.editionId=edition.editionId;
      title.lang=edition.titleLanguage;title.textContent=edition.title;
      link.append(title,document.createTextNode(' · '+edition.author+' · '+edition.languageName+' · '+(reviewLabels[edition.reviewCategory]??'')+(id?' · '+id.split(':').pop():'')));
      return link;
    };
    const initial=new URLSearchParams(location.search).get('author');
    if(initial&&[...author.options].some(option=>option.value===initial)){author.value=initial;filter();}
    const runSearch=async()=>{
      const parameters={query:query.value,locale:form.dataset.locale!,language:language.value,author:author.value};
      clearResults();filter();
      if(!normalizeQuery(parameters.query)){controller.cancel();status.textContent=cards.some(card=>!card.hidden)?'':form.dataset.none!;return;}
      status.textContent=form.dataset.loading!;
      try{
        const found=await controller.search(parameters);
        if(!found)return;
        const editionsFragment=document.createDocumentFragment(),passagesFragment=document.createDocumentFragment();
        for(const edition of found.editions){
          const item=document.createElement('li');item.append(editionLink(edition));editionsFragment.append(item);
        }
        for(const {edition,id,text} of found.passages){
          const item=document.createElement('li'),excerpt=document.createElement('p');
          excerpt.lang=edition.language;excerpt.textContent=text.length>280?text.slice(0,280)+'…':text;
          item.append(editionLink(edition,id),excerpt);passagesFragment.append(item);
        }
        editionList.append(editionsFragment);list.append(passagesFragment);
        filter(found.workIds);editionResults.hidden=found.editions.length===0;results.hidden=found.passageCount===0;
        status.textContent=found.workIds.size?[
          found.workIds.size+' · '+labels.works,
          ...(found.editions.length?[found.editions.length+' · '+labels.editions]:[]),
          ...(found.passageCount?[found.passages.length+(found.passageCount>found.passages.length?' / '+found.passageCount:'')+' · '+form.dataset.results]:[]),
        ].join('; '):form.dataset.none!;
      }catch{status.textContent=form.dataset.unavailable!;filter();}
    };
    language.addEventListener('change',()=>{void runSearch();});author.addEventListener('change',()=>{void runSearch();});
    query.addEventListener('input',()=>{controller.cancel();clearResults();filter();status.textContent=cards.some(card=>!card.hidden)?'':form.dataset.none!;});
    form.addEventListener('submit',event=>{event.preventDefault();void runSearch();});
  }
</script>
</Base>
