---
import Base from '../../../../layouts/Base.astro';
import {supported,strings,catalog,languageNames,issueUrl,type Locale} from '../../../../lib/corpus';
import sample from '../../../../../corpus/segments/demo-proust/fr.json';
export function getStaticPaths(){return supported.flatMap(lang=>catalog.flatMap(w=>w.editions.map(e=>({params:{lang,work:w.id,edition:e.language}}))));}
const lang=Astro.params.lang as Locale;const t=strings[lang];const w=catalog.find(w=>w.id===Astro.params.work)!;const edition=w.editions.find(e=>e.language===Astro.params.edition)!;
const passages=edition.language==='fr'?Object.entries(sample):[];
---
<Base lang={lang} title={w.title+' — '+languageNames[edition.language]}><div class="container reader-head"><p class="eyebrow">{w.author} · {languageNames[edition.language]}</p><h1>{w.title}</h1><div class="tools"><a href={'/'+lang+'/works/'+w.id+'/'}>← {t.all}</a><a href={issueUrl(w.id,edition.language)} target="_blank" rel="noopener noreferrer">{t.feedback} ↗</a><a href="https://github.com/streamentry/LitMundi/tree/main/corpus" target="_blank" rel="noopener noreferrer">View source data ↗</a></div><p class="muted">{edition.label} · Status: {edition.status} · Source: {w.source.url}</p></div><article class="reader"><aside class="notice">{t.draft} {t.copyright}</aside>{passages.length?passages.map(([id,value])=><p class="segment" id={id}><a class="segment-link" aria-label={'Link to passage '+id} href={'#'+id}>§</a><span lang={edition.language}>{value}</span> <a class="segment-link" href={issueUrl(w.id,edition.language,id)} target="_blank" rel="noopener noreferrer" aria-label={'Report issue in '+id}>✎</a></p>):<div class="notice"><p>{t.empty}</p><a href={issueUrl(w.id,edition.language)}>{t.feedback} ↗</a></div>}</article></Base>