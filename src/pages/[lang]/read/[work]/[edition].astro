---
import Base from '../../../../layouts/Base.astro';
import Passage from '../../../../components/Passage.astro';
import OriginalTitle from '../../../../components/OriginalTitle.astro';
import Citation from '../../../../components/Citation.astro';
import {strings,supported,type Locale} from '../../../../lib/i18n';
import {catalog,languageNames,issueUrl,passagesFor,readableEditions,publishedEditions,resolveEdition,parallelFor,publicWorks,bestEdition,reviewCategory,editionTitle} from '../../../../lib/corpus';
import {pagePath,assetPath} from '../../../../lib/urls';
import {canonicalEditionPath} from '../../../../lib/seo';
import {labels,workSummary,authorSlug,readerPageTitle,readerPageDescription} from '../../../../lib/discovery';
export function getStaticPaths(){return supported.flatMap(lang=>catalog.flatMap(w=>readableEditions(w.id).flatMap(e=>[e.id,...e.legacy_slugs].map(slug=>({params:{lang,work:w.id,edition:slug}})))));}
const lang=Astro.params.lang as Locale,t=strings[lang],d=labels(lang);
const w=catalog.find(w=>w.id===Astro.params.work)!;
const e=resolveEdition(w.id,Astro.params.edition!)!;
const title=editionTitle(w,e),titleLanguage=e.title?e.language:w.original_language;
const showOriginal=e.kind==='translation'&&title!==w.title;
const legacy=e.id!==Astro.params.edition,current=pagePath(lang,'read',w.id,e.id);
const passages=passagesFor(e),parallel=parallelFor(e),reading=readableEditions(w.id);
const published=e.status==='published'&&w.visibility==='public',noindex=!published||legacy;
const canonical=published?canonicalEditionPath(e):current;
const canonicalUrl=new URL(canonical,Astro.site).href;
const summary=workSummary(w,lang);
const authorUrl=new URL(pagePath('en','authors'),Astro.site).href+'#'+authorSlug(w.author);
const breadcrumbs=[{name:d.collection,href:pagePath(lang)},{name:editionTitle(w,bestEdition(w,lang)),href:pagePath(lang,'works',w.id)},{name:title,href:canonical}];
const category=reviewCategory(e);
const notice=category==='ai'?t.aiNotice:category==='human'?t.humanNotice:category==='source'?t.sourceNotice:t.translationNotice;
const badge=category==='ai'?t.aiReviewed:category==='human'?t.humanReviewed:category==='source'?t.sourcePublished:t.translationPublished;
const publicCatalog=publicWorks(),position=publicCatalog.findIndex(work=>work.id===w.id);
const previous=position>0?publicCatalog[position-1]:null,next=position>=0?publicCatalog[position+1]:null;
const previousEdition=previous?bestEdition(previous,lang):null,nextEdition=next?bestEdition(next,lang):null;
const feedback='https://github.com/streamentry/LitMundi/issues/new?'+new URLSearchParams({title:'Reading feedback: '+w.id,body:'## What I read\nWork: '+w.id+'\nEdition: '+e.id+'\n\n## Did you finish the work? Where did you stop?\n\n## What made reading easier or harder?\n\n## Would you return or recommend it? Why?\n\n## A specific improvement\n\nPlease do not include personal or sensitive information. This is a public GitHub issue.'}).toString();
const editionReference=(edition:typeof e)=>{
  const url=new URL(canonicalEditionPath(edition),Astro.site).href;
  return {'@type':'CreativeWork','@id':url+'#edition',url,identifier:edition.id,name:editionTitle(w,edition),inLanguage:edition.language};
};
const translations=publishedEditions(w.id).filter(edition=>edition.kind==='translation'&&edition.source_edition_id===e.id);
const structuredData=published?{
  '@context':'https://schema.org','@type':'CreativeWork','@id':canonicalUrl+'#edition',
  name:title,alternateName:showOriginal?w.title:undefined,
  author:{'@type':'Person','@id':authorUrl,url:authorUrl,name:w.author},inLanguage:e.language,
  publisher:{'@id':new URL(pagePath(),Astro.site).href+'#publisher'},
  url:canonicalUrl,mainEntityOfPage:canonicalUrl,identifier:e.id,isAccessibleForFree:true,
  description:summary.text,version:e.label,citation:parallel?.source.provenance.citation??e.provenance.citation,
  isBasedOn:e.provenance.text_url??undefined,
  translationOfWork:parallel?editionReference(parallel.source):undefined,
  workTranslation:translations.length?translations.map(editionReference):undefined,
  copyrightNotice:e.rights.basis,
  creativeWorkStatus:category==='ai'?'AI-reviewed publication':category==='human'?'Human-reviewed publication':category==='source'?'Published source':'Published translation',
  ...(e.credits.translator&&category==='human'?{translator:{'@type':'Person',name:e.credits.translator}}:{}),
  ...(e.credits.translator?{creditText:'Translation: '+e.credits.translator}:{}),
  ...(e.rights.license==='CC-BY-4.0'?{license:'https://creativecommons.org/licenses/by/4.0/'}:e.rights.license==='CC0-1.0'?{license:'https://creativecommons.org/publicdomain/zero/1.0/'}:{})
}:undefined;
---
<Base lang={lang} title={readerPageTitle(w,e,languageNames)} description={readerPageDescription(w,e,lang,languageNames)} noindex={noindex} canonicalPath={canonical} structuredData={structuredData} breadcrumbs={breadcrumbs} socialImage={published?assetPath('social/'+w.id+'.png'):undefined} socialImageAlt={published?w.title+' — '+w.author:undefined}>
<div class="container"><section class="reader-head">
  <p class="eyebrow">{published?<a href={pagePath(lang,'authors')+'#'+authorSlug(w.author)}>{w.author}</a>:w.author} · {languageNames[e.language]??e.language}</p>
  <h1 lang={titleLanguage} data-edition-title={e.id}>{title}</h1>
  {showOriginal&&<OriginalTitle title={w.title} language={w.original_language} locale={lang}/>}
  <p lang={summary.language} data-work-summary={w.id}>{summary.text}</p>
  <p class="muted" lang={e.kind==='source'?'en':e.language}>{e.label}</p>
  <div class="tools"><a href={pagePath(lang,'works',w.id)}>← {t.all}</a><a href={issueUrl(w.id,e.id)}>{t.feedback} <span aria-hidden="true">↗</span></a></div>
  <details class="edition-picker"><summary>{t.edition}: {languageNames[e.language]??e.language}</summary><ul>{reading.map(other=><li><a href={pagePath(lang,'read',w.id,other.id)} aria-current={other.id===e.id?'page':undefined}><span lang={other.title?other.language:w.original_language}>{editionTitle(w,other)}</span> · {languageNames[other.language]??other.language} · {other.label}</a></li>)}</ul></details>
  {legacy&&<p class="notice"><a href={current}>{t.legacy}</a></p>}
  <div class="notice" data-review-category={category} data-publication-policy={e.publication_policy}><p><strong>{published?notice:t.sampleNotice}</strong></p>{published&&category==='ai'&&typeof e.review.score==='number'&&<p data-ai-score={e.review.score}>{t.aiScore}: <strong>{e.review.score.toLocaleString(lang,{minimumFractionDigits:1,maximumFractionDigits:2})}/10</strong>. {t.scoreContext}</p>}{e.provenance.text_url&&<p><a href={e.provenance.text_url}>{t.sourceWitness} <span aria-hidden="true">↗</span></a></p>}</div>
  <details class="metadata"><summary>{t.provenance}</summary><dl>
    <dt>{t.sourceWitness}</dt><dd lang="en">{e.provenance.citation}{e.provenance.catalog_url&&<p><a href={e.provenance.catalog_url}>{e.provenance.catalog_url}</a></p>}</dd>
    <dt>{t.editionId}</dt><dd><code>{e.id}</code></dd>
    <dt>{t.author}</dt><dd>{e.credits.author}</dd>
    {e.credits.translator&&<><dt>{category==='ai'?t.translationCredit:t.translator}</dt><dd>{e.credits.translator}</dd></>}
    {e.credits.editors.length>0&&<><dt>{t.editors}</dt><dd>{e.credits.editors.join(', ')}</dd></>}
    {e.review.reviewers.length>0&&<><dt>{t.reviewers}</dt><dd>{e.review.reviewers.join(', ')}</dd></>}
    {(e.review.ai_reviewers?.length??0)>0&&<><dt>{t.aiReviewers}</dt><dd>{e.review.ai_reviewers!.join(', ')}</dd></>}
    {e.publication_policy&&<><dt>{t.publicationPolicy}</dt><dd><a href={pagePath(lang,'quality')}>{e.publication_policy}</a></dd></>}
    <dt>{t.review}</dt><dd><p lang="en">{e.review.notes}</p><ul>{e.review.evidence_urls.map(url=><li><a href={url}>{url}</a></li>)}</ul>{e.credits.ai_assisted&&<p>{t.aiAssisted}</p>}</dd>
    <dt>{t.license}</dt><dd lang="en">{e.rights.license??'No publication license granted.'}</dd>
    <dt>{t.rights}</dt><dd><p lang="en">{e.rights.basis}</p><ul>{e.rights.evidence_urls.map(url=><li><a href={url}>{url}</a></li>)}</ul></dd>
  </dl></details>
  {published&&<details class="metadata"><summary>{t.download}</summary><p>{t.downloadHint}</p><div class="download-links">{['json','txt','epub'].map(format=><a href={assetPath('downloads/'+e.id+'.'+format)} download>{format.toUpperCase()}</a>)}</div></details>}
  {published&&<Citation work={w} edition={e} source={parallel?.source} locale={lang}/>}
</section></div>
<div class="reader-shell" data-edition={e.id}>
  <div class="reading-tools">
    {published&&<div class="progress-controls" hidden data-progress-controls data-storage-error={t.storageUnavailable}>
      <div class="progress-top"><label for="reading-progress">{t.readingProgress}</label><progress id="reading-progress" max={passages.length} value="0"></progress><output id="progress-count">0 / {passages.length}</output></div>
      <div class="bookmark-controls"><label><input type="checkbox" id="remember-place" />{t.remember}</label><a id="resume-reading" href={current} hidden>{t.resume}</a><button id="clear-progress" type="button" hidden>{t.clearProgress}</button></div>
      <p class="muted" id="progress-message">{t.progressHint}</p>
    </div>}
    <details><summary>{t.contents} · {passages.length}</summary><nav aria-label={t.contents}><ol>{passages.map(([id])=><li><a href={'#'+id} aria-label={t.passage+' '+id.split(':').pop()}>{id.split(':').pop()}</a></li>)}</ol></nav></details>
    {parallel&&<>
      <div class="comparison-control"><label for="show-original"><input id="show-original" type="checkbox" autocomplete="off" aria-controls="parallel-text" />{t.showOriginal}</label><span class="muted" lang={parallel.source.language}>{languageNames[parallel.source.language]??parallel.source.language}</span></div>
      <p class="muted comparison-hint">{t.compareHint}</p>
    </>}
  </div>
  {parallel?<article id="parallel-text" class="parallel-reader" lang={e.language} aria-label={title}>
    <div class="parallel-heading"><h2>{languageNames[parallel.source.language]??parallel.source.language} · {t.original}</h2><h2>{languageNames[e.language]??e.language} · {badge}</h2></div>
    {parallel.rows.map(row=><div class="parallel-row">
      <section class="parallel-cell" data-source-cell={parallel.source.id} aria-label={languageNames[parallel.source.language]??parallel.source.language}><p class="language-label">{languageNames[parallel.source.language]??parallel.source.language}</p>{row.source.map(([id,text])=><Passage id={id} anchorId={'source-'+id} permalink={pagePath(lang,'read',w.id,parallel.source.id)+'#'+id} text={text} language={parallel.source.language} locale={lang} workId={w.id} editionId={parallel.source.id} track={false}/>)}</section>
      <section class="parallel-cell" data-target-cell={e.id} aria-label={languageNames[e.language]??e.language}><p class="language-label">{languageNames[e.language]??e.language}</p>{row.target.map(([id,text])=><Passage id={id} text={text} language={e.language} locale={lang} workId={w.id} editionId={e.id}/>)}</section>
    </div>)}
  </article>:<article class="reader" lang={e.language} aria-label={title}>{passages.map(([id,text])=><Passage id={id} text={text} language={e.language} locale={lang} workId={w.id} editionId={e.id}/>)}</article>}
  {published&&<div class="reader-feedback"><a href={feedback}>{t.readerFeedback} <span aria-hidden="true">↗</span></a></div>}
  {published&&<nav class="next-works" aria-label={t.works}>{previous&&previousEdition?<a href={pagePath(lang,'read',previous.id,previousEdition.id)}><span>{t.previous}</span><span class="navigation-title" data-navigation-title={previousEdition.id} lang={previousEdition.title?previousEdition.language:previous.original_language}>{editionTitle(previous,previousEdition)}</span></a>:<a href={pagePath(lang)}>{t.back}</a>}{next&&nextEdition&&<a href={pagePath(lang,'read',next.id,nextEdition.id)}><span>{t.next}</span><span class="navigation-title" data-navigation-title={nextEdition.id} lang={nextEdition.title?nextEdition.language:next.original_language}>{editionTitle(next,nextEdition)}</span></a>}</nav>}
</div>
<script>import '../../../../scripts/reading-progress';</script>
</Base>
