---
import '../styles/global.css';
import {strings,supported,localeNames,type Locale} from '../lib/i18n';
import {pagePath,assetPath,basePath} from '../lib/urls';
import {seoForPath} from '../lib/seo';
import {serializeStructuredData} from '../../scripts/lib/reader-data.mjs';
interface Props {lang?:Locale;title?:string;description?:string;noindex?:boolean;canonicalPath?:string;structuredData?:Record<string,unknown>}
const {lang='en',title='LitMundi',description,noindex=false,canonicalPath,structuredData}=Astro.props;
const t=strings[lang];
const canonical=new URL(canonicalPath??Astro.url.pathname,Astro.site);
const alternates=noindex?[]:(seoForPath(Astro.url.pathname,Astro.site!)?.alternates??[]);
const routeParts=canonical.pathname.slice(basePath.length).split('/').filter(Boolean).slice(1);
const localePath=(locale:Locale)=>pagePath(locale,...routeParts);
const names=localeNames;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#24553e" />
  <meta name="description" content={description??t.intro} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonical} />
  {alternates.map(({hreflang,href})=><link rel="alternate" hreflang={hreflang} href={href} />)}
  <link rel="sitemap" type="application/xml" href={new URL(assetPath('sitemap-index.xml'),Astro.site)} />
  <link rel="icon" type="image/svg+xml" href={assetPath('favicon.svg')} />
  <meta property="og:title" content={title+' · LitMundi'} />
  <meta property="og:description" content={description??t.intro} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  {structuredData && <script type="application/ld+json" is:inline set:html={serializeStructuredData(structuredData)} />}
  <title>{title} · LitMundi</title>
</head>
<body>
  <a class="skip-link" href="#main">{t.skip}</a>
  <header class="topbar">
    <div class="container nav">
      <a class="logo" href={pagePath(lang)} aria-label="LitMundi">LitMundi<span aria-hidden="true">.</span></a>
      <nav class="links" aria-label={t.navigation}>
        <a href={pagePath(lang)}>{t.works}</a>
        <a href={pagePath(lang,'quality')}>{t.quality}</a>
        <details class="locale-menu">
          <summary>{t.websiteLanguage}: <span lang={lang}>{names[lang]}</span></summary>
          <ul>{supported.map(locale=><li><a data-locale-link href={localePath(locale)} lang={locale} hreflang={locale} aria-current={locale===lang?'true':undefined}>{names[locale]}</a></li>)}</ul>
        </details>
      </nav>
    </div>
  </header>
  <main id="main" tabindex="-1"><slot /></main>
  <footer class="footer">
    <div class="container footer-inner">
      <div><a class="logo" href={pagePath(lang)}>LitMundi<span aria-hidden="true">.</span></a><p>{t.footer}</p></div>
      <nav aria-label={t.preservation}>
        <a href="https://github.com/streamentry/LitMundi/blob/main/LICENSE">{t.codeLicense}</a>
        <a href="https://github.com/streamentry/LitMundi/blob/main/docs/PRESERVATION.md">{t.preservation}</a>
        <a href={assetPath('sitemap-index.xml')}>{t.sitemap}</a>
        <a href="https://github.com/streamentry/LitMundi/issues">{t.github}</a>
        <a href="https://github.com/streamentry/LitMundi/issues/new?template=reader-feedback.yml">{t.readerFeedback}</a>
      </nav>
    </div>
  </footer>
  <script>
    if (location.hash) document.querySelectorAll<HTMLAnchorElement>('[data-locale-link]').forEach(link => {link.hash=location.hash;});
  </script>
</body>
</html>
