{
  "name": "litmundi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && npm run downloads && npm run social:images && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "node scripts/validate.mjs && node scripts/validate-atlas.mjs && node scripts/translation-todo.mjs check",
    "export": "npm run validate && node scripts/export.mjs && python3 dist-archive/restore.py --verify-only",
    "test": "node --test tests/*.test.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "quality:status": "node scripts/quality-status.mjs",
    "downloads": "node scripts/downloads.mjs",
    "social:images": "node scripts/social-images.mjs",
    "indexnow": "python3 scripts/indexnow.py",
    "verify:archive": "node scripts/verify-archive.mjs",
    "review:packet": "npm run validate && node scripts/review-packet.mjs",
    "verify:ids": "node scripts/verify-identifiers.mjs",
    "verify:deployed": "python3 scripts/verify-deployed.py",
    "todo:check": "node scripts/translation-todo.mjs check",
    "todo:render": "node scripts/translation-todo.mjs write",
    "todo:next": "node scripts/translation-todo.mjs next"
  },
  "dependencies": {
    "astro": "^5.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
    "sharp": "0.34.5",
    "typescript": "^5.9.3"
  }
}
