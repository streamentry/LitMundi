{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"LitMundi technical original-source comparison",
  "type":"object",
  "required":["edition_id","work_id","checked_at","checker_kind","source_sha256","segments_checked","witness_url","witness_pages","notes"],
  "properties":{
    "edition_id":{"type":"string","minLength":1},
    "work_id":{"type":"string","minLength":1},
    "checked_at":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "checker_kind":{"enum":["ai_assisted","human"]},
    "checked_by":{"type":"string","minLength":1},
    "source_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "segments_checked":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "witness_url":{"type":"string","pattern":"^https?://"},
    "witness_pages":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "notes":{"type":"string","minLength":80}
  },
  "allOf":[{"if":{"properties":{"checker_kind":{"const":"human"}}},"then":{"required":["checked_by"]}}],
  "additionalProperties":true
}
