{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LitMundi Canonical Segment Structure",
  "type": "object",
  "required": [
    "schema_version",
    "work_id",
    "segment_ids",
    "deprecated_ids"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "work_id": {
      "type": "string"
    },
    "segment_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "deprecated_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
