{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/streamentry/LitMundi/blob/main/corpus/schemas/edition.schema.json",
  "title": "LitMundi Edition",
  "type": "object",
  "required": [
    "id",
    "work_id",
    "language",
    "kind",
    "status",
    "label",
    "content_path",
    "source_edition_id",
    "legacy_slugs",
    "provenance",
    "rights",
    "credits",
    "review"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "work_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "kind": {
      "enum": [
        "source",
        "translation"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "draft",
        "sample",
        "published",
        "withdrawn"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "content_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_edition_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "legacy_slugs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "citation",
        "catalog_url",
        "text_url",
        "retrieved_at",
        "source_witness"
      ],
      "properties": {
        "citation": {
          "type": "string"
        },
        "catalog_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_witness": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "rights": {
      "type": "object",
      "required": [
        "status",
        "license",
        "basis",
        "jurisdictions_assessed",
        "evidence_urls"
      ],
      "properties": {
        "status": {
          "enum": [
            "unreviewed",
            "public_domain_assessed",
            "cleared",
            "disputed"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "type": "string"
        },
        "jurisdictions_assessed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "credits": {
      "type": "object",
      "required": [
        "author",
        "translator",
        "editors",
        "ai_assisted"
      ],
      "properties": {
        "author": {
          "type": "string"
        },
        "translator": {
          "type": [
            "string",
            "null"
          ]
        },
        "editors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ai_assisted": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "reviewers",
        "evidence_urls",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "unreviewed",
            "source_checked",
            "bilingual_reviewed",
            "literary_edited",
            "expert_reviewed",
            "ai_reviewed"
          ]
        },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "rubric_id": {
          "enum": [
            "litmundi-literary-v1",
            "litmundi-literary-v2"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "ai_reviewers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "record_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^corpus/reviews/[a-z][a-z0-9-]+/[a-z][a-z0-9-]+/[A-Za-z0-9-]+\\.json$"
          }
        }
      },
      "additionalProperties": false
    },
    "editorial_attestation": {
      "type": "object",
      "required": [
        "verified_by",
        "verified_at",
        "evidence_url",
        "source_sha256",
        "target_sha256",
        "reviewer_handles",
        "license_consent_urls",
        "checks"
      ],
      "properties": {
        "verified_by": {
          "type": "string",
          "minLength": 1
        },
        "verified_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "evidence_url": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewer_handles": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "license_consent_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "object",
          "required": [
            "reviewer_identity",
            "reviewer_qualifications",
            "reviewer_independence",
            "source_rights",
            "contributor_consent"
          ],
          "properties": {
            "reviewer_identity": {
              "type": "boolean"
            },
            "reviewer_qualifications": {
              "type": "boolean"
            },
            "reviewer_independence": {
              "type": "boolean"
            },
            "source_rights": {
              "type": "boolean"
            },
            "contributor_consent": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "publication_policy": {
      "enum": [
        "litmundi-literary-v1",
        "litmundi-literary-v2"
      ]
    },
    "generation": {
      "type": "object",
      "required": [
        "kind",
        "tools",
        "direct_from_original",
        "human_contributors",
        "notes"
      ],
      "properties": {
        "kind": {
          "const": "ai_generated"
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "direct_from_original": {
          "type": "boolean"
        },
        "human_contributors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "consent_url"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "consent_url": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "string",
          "minLength": 30
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
