  "findings": [
    {
      "segment": "tagore-post-office:2.28",
      "category": "imagery_consistency",
      "severity": "major",
      "status": "resolved",
      "explanation": "‘পণ্ডিত’ (the scholars Amal refuses to become) was rendered differently in Acts I and II, losing the echo of the motif; unified as ‘học giả’."
    },
    {
      "segment": "tagore-post-office:3.121",
      "category": "semantic_fidelity",
      "severity": "major",
      "status": "resolved",
      "explanation": "The hour-count rendered as ‘bốn canh’ placed the scene after midnight, contradicting the king’s coming at midnight; now a loose evening time."
    },
    {
      "segment": "tagore-post-office:3.139",
      "category": "semantic_fidelity",
      "severity": "major",
      "status": "resolved",
      "explanation": "The speaker labelled ‘কবিরাজ’ in the source (units 393, 395, 397) is the royal physician; relabelled ‘Ngự y’ and recorded in the glossary."
    },
    {
      "segment": "tagore-post-office:2.85",
      "category": "semantic_fidelity",
      "severity": "minor",
      "status": "resolved",
      "explanation": "The palm-leaf umbrella had been rendered as a hat; now a ‘dù lá gồi’."
    },
    {
      "segment": "tagore-post-office:3.24",
      "category": "target_naturalness",
      "severity": "minor",
      "status": "resolved",
      "explanation": "A calque in the vocative order (‘Amal con’); now ‘Amal con ơi’."
    },
    {
      "segment": "tagore-post-office:3.165",
      "category": "literary_voice",
      "severity": "minor",
